PAY_TO=0xYourKiteWalletAddress
KITE_NETWORK=testnet

# Tiered pricing (USD). Public JSON-RPC is free, so the split reflects value:
#   PRICE_USD          -> current gas snapshot (cheap, standard)
#   PRICE_USD_PREMIUM  -> fee history series + tx cost estimation
#                         (server-computed / larger payload, premium)
PRICE_USD=0.001
PRICE_USD_PREMIUM=0.01

# Per-client rate limit on paid calls (requests/min). 0 disables.
RATE_LIMIT_PER_MIN=10

# Guards
RPC_TIMEOUT_MS=9000
MAX_CHAINS=10
SNAPSHOT_BLOCKS=5
MAX_HISTORY_BLOCKS=100

# Optional: restrict/override the chain registry.
#   CHAINS=ethereum,base,kite-testnet
#   RPC_URL_ETHEREUM=https://my-private-rpc.example

SERVICE_DESCRIPTION=Multi-chain gas oracle (EIP-1559 base fee + priority fee percentiles, fee history and tx cost estimation) for the Kite network
PORT=8080
